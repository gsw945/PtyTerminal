<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PtyWeb.SignalR</AssemblyName>
    <RootNamespace>PtyWeb.SignalR</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Pty.Net\Pty.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also copy wwwroot next to the executable so the demo works when launched
         directly (not only via dotnet run), including in Production environment. -->
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
